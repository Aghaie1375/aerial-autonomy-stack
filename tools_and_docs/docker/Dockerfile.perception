FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gnupg ca-certificates build-essential cmake git python3-pip \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu noble main" > /etc/apt/sources.list.d/ros2.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-ros-base ros-jazzy-cv-bridge ros-jazzy-image-transport \
    python3-colcon-common-extensions python3-opencv \
    && pip3 install --break-system-packages onnxruntime numpy \
    && rm -rf /var/lib/apt/lists/*

# Build Livox SDK2 + ROS 2 driver and KISS-ICP odometry
COPY _github_clones/Livox-SDK2 /ws/Livox-SDK2
RUN mkdir -p /ws/Livox-SDK2/build && cd /ws/Livox-SDK2/build \
    && cmake .. && make -j$(nproc) && make install

WORKDIR /ws/perception_ws
COPY _github_clones/livox_ros_driver2 src/livox_ros_driver2
COPY _github_clones/kiss-icp src/kiss-icp
RUN bash -c "source /opt/ros/jazzy/setup.bash && colcon build --symlink-install"

CMD ["bash", "-c", "source /opt/ros/jazzy/setup.bash && source /ws/perception_ws/install/setup.bash && exec bash"]